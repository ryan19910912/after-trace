{
  "name": "after-trace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev:api": "pnpm --filter @aftertrace/api dev",
    "dev:web": "pnpm --filter @aftertrace/web dev",
    "dev:admin": "pnpm --filter @aftertrace/admin dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:migrate": "pnpm --filter @aftertrace/api exec drizzle-kit migrate --config=../../drizzle.config.ts",
    "db:schema:check": "pnpm --filter @aftertrace/api exec drizzle-kit export --dialect=postgresql --schema=src/db/schema-all.ts > aftertrace-schema.sql"
  },
  "devDependencies": {
    "eslint": "^10.9.1",
    "typescript-eslint": "^8.41.0"
  }
}
