DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
GEMINI_API_KEY=

# Billable AI is disabled until these runtime pricing/FX snapshots are configured.
# Keep prices current with the provider; do not bake them into memory-domain code.
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_INPUT_USD_PER_MILLION_TOKENS=
GEMINI_OUTPUT_USD_PER_MILLION_TOKENS=
USD_TWD_RATE=

# Optional product-config overrides. Leave blank to use confirmed V1 defaults.
CONVERSATION_EXTRACTION_MESSAGE_THRESHOLD=30
CONVERSATION_EXTRACTION_CHAR_THRESHOLD=5000
CONVERSATION_LARGE_MESSAGE_CHARS=2000
CONVERSATION_EXTRACTION_LEASE_SECONDS=120
MEMORY_REQUEST_LEASE_SECONDS=120
WELCOME_FIRST_GROUP_COST_TWD=1
WELCOME_LATER_GROUP_COST_TWD=0.5
REWARDED_AD_COST_TWD=0.01
REWARDED_AD_DAILY_LIMIT=5
REWARDED_AD_COOLDOWN_MINUTES=15
UNPAID_RETENTION_DAYS=30
PAID_RETENTION_DAYS=365

VITE_LIFF_ID=
VITE_API_BASE_URL=http://localhost:8787
