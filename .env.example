# AFTERTRACE shared local environment.
# Copy to repository-root .env.local and replace placeholders.
# Drizzle tooling reads this file directly, and pnpm dev:api loads the same file into Wrangler local bindings.

# PostgreSQL / Neon used by local development and local DB commands.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/aftertrace?sslmode=require

# Web/PWA
WEB_APP_URL=http://localhost:5173
WEB_APP_ORIGIN=http://localhost:5173
WEB_AUTH_SECRET=replace-with-at-least-32-random-characters

# Admin
ADMIN_WEB_ORIGIN=http://localhost:5174
ADMIN_USERNAME=admin
# At least 16 characters. Use a unique random production value in Cloudflare Secrets.
ADMIN_PASSWORD=replace-with-at-least-16-characters
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Messaging API / LINE Login
LINE_CHANNEL_SECRET=replace-with-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=replace-with-line-channel-access-token
LINE_LOGIN_CHANNEL_ID=2011322889
LINE_LOGIN_CHANNEL_SECRET=replace-with-line-login-channel-secret

# Gemini provider credential
GEMINI_API_KEY=replace-with-gemini-api-key

# Frontend build-time API URL shared by Web/Admin for local development.
VITE_API_BASE_URL=http://127.0.0.1:8787

# Deployment helper targets. AFTERTRACE_API_URL is the deployed API origin. The
# production DB URL is intentionally separate from local DATABASE_URL so
# worker-deploy.ps1 cannot silently migrate a development database.
AFTERTRACE_API_URL=https://after-trace-api.<account-subdomain>.workers.dev
AFTERTRACE_PROD_DATABASE_URL=postgresql://PROD_USER:PROD_PASSWORD@PROD_HOST/aftertrace?sslmode=require
