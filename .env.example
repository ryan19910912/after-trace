# AFTERTRACE 共用環境變數範例。
# 本機開發請複製成專案根目錄的 .env.local。
# 共用 Dev Worker 部署請維護 .env.dev；Prod Worker 部署請維護 .env.prod。
# pnpm deploy:dev 只讀 .env.dev；pnpm deploy:prod 只讀 .env.prod，避免兩個環境互相污染。
# 部署 API 時，腳本會把下列 API runtime 需要的欄位挑出後，透過 Wrangler secrets-file 同步到對應 Worker。
# 不會直接把整份 .env.dev / .env.prod 上傳，暫存 secrets 檔也會在部署後刪除。
# 專案已全面改用 Cloudflare Workers；不要再使用舊的 *.pages.dev 網址。

# PostgreSQL / Neon 連線字串。
# .env.local、.env.dev、.env.prod 都應指向各自獨立的資料庫。
# deploy:dev / deploy:prod 在部署 API 前會使用該環境的 DATABASE_URL 執行 migration，並同步成 API Worker runtime binding。
DATABASE_URL=postgresql://USER:PASSWORD@HOST/aftertrace?sslmode=require

# Web/PWA 對外網址，API 產生登入導向等功能時會使用。
# Local：http://localhost:5173
# Dev：https://after-trace-web-dev.a0955625660.workers.dev
# Prod：https://after-trace-web-prod.a0955625660.workers.dev
WEB_APP_URL=http://localhost:5173

# Web/PWA 允許的 Origin，用於 API 的 Web/CORS/驗證邊界。
# 必須與同一環境的 WEB_APP_URL 完全相同，不可再填舊的 after-trace.pages.dev。
# Local：http://localhost:5173
# Dev：https://after-trace-web-dev.a0955625660.workers.dev
# Prod：https://after-trace-web-prod.a0955625660.workers.dev
WEB_APP_ORIGIN=http://localhost:5173

# Web/PWA 登入與短期入口 token 簽章使用的密鑰。
# 至少 32 個字元；Dev / Prod 請使用不同值，不要與其他 secret 共用。
WEB_AUTH_SECRET=replace-with-at-least-32-random-characters

# Admin Web 對外網址，用於 Admin API 的 Origin/CORS 驗證。
# Local：http://localhost:5174
# Dev：https://after-trace-admin-dev.a0955625660.workers.dev
# Prod：https://after-trace-admin-prod.a0955625660.workers.dev
ADMIN_WEB_ORIGIN=http://localhost:5174

# AFTERTRACE 內部管理後台登入帳號。
# Dev / Prod 可各自設定，這不是一般使用者帳號。
ADMIN_USERNAME=admin

# AFTERTRACE 內部管理後台登入密碼。
# 至少 8 個字元；Local / Dev / Prod 都套用相同最小長度規則。
# Dev / Prod 建議使用不同密碼；部署 API 時會以 Worker Secret 方式同步。
ADMIN_PASSWORD=replace-with-at-least-8-characters

# Admin 登入 session / bearer token 簽章使用的密鑰。
# 至少 32 個字元；Dev / Prod 請使用不同值，也不要與 WEB_AUTH_SECRET 共用。
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# LINE Messaging API Channel Secret。
# LINE OA 現在只保留「聯絡客服」外部支援管道；不要用它恢復舊的小跡 Record/GROUP/AI runtime。
LINE_CHANNEL_SECRET=replace-with-line-channel-secret

# LINE Messaging API Channel Access Token。
# Dev / Prod 各自使用對應官方帳號 channel 的 token，不可共用。
LINE_CHANNEL_ACCESS_TOKEN=replace-with-line-channel-access-token

# LINE Login Channel ID。
# LINE Login 只是 provider-neutral AFTERTRACE account 的登入 provider，不是 core account identity。
LINE_LOGIN_CHANNEL_ID=replace-with-line-login-channel-id

# LINE Login Channel Secret。
# Dev / Prod 各自使用對應 LINE Login channel 的 secret，不可共用。
LINE_LOGIN_CHANNEL_SECRET=replace-with-line-login-channel-secret

# Gemini API 金鑰。
# 只用於符合 FREE 一次性 AI 試用或 AI_PRO entitlement 的 provider-backed AI；所有 provider 呼叫必須走點數/成本稽核。
GEMINI_API_KEY=replace-with-gemini-api-key

# Web Push VAPID 公開金鑰（P-256 uncompressed public key 的 base64url）。
# Web/PWA 會把這個 public key 傳給 PushManager.subscribe()；它不是秘密，但仍由 API runtime 統一提供。
WEB_PUSH_PUBLIC_KEY=replace-with-vapid-public-key

# Web Push VAPID 私鑰（32-byte P-256 private scalar 的 base64url）。
# 只能存在 Local / Dev / Prod secret 檔與 Cloudflare Worker Secret，不可送到 Web/PWA。
WEB_PUSH_PRIVATE_KEY=replace-with-vapid-private-key

# VAPID subject/contact。必須是 mailto: 或 HTTPS URL，例如 mailto:support@example.com。
# 這是 push service 聯絡 application server operator 的識別，不是使用者客服 UI 文案。
WEB_PUSH_SUBJECT=mailto:support@example.com

# AFTERTRACE 唯一的 API Base URL。
# Local：http://127.0.0.1:8787
# Dev：https://after-trace-api-dev.a0955625660.workers.dev
# Prod：https://after-trace-api-prod.a0955625660.workers.dev
# Web / Admin build 與手動 deploy command 都使用這個值；這個欄位本身不需要成為 API runtime binding。
VITE_API_BASE_URL=http://127.0.0.1:8787

# 選填：AFTERTRACE LINE 官方帳號聯絡客服網址，例如 https://lin.ee/xxxxxxxx。
# 只用於 Web/PWA 的「聯絡客服」動作；不要拿來恢復 LINE 記錄、LINE GROUP、Reply cache 或 AI 責任人流程。
VITE_LINE_OA_ADD_URL=

# 選填：LINE Official Account Manager 提供或自行託管的官方加好友 QR Code 圖片網址。
# Desktop Web 可顯示客服 QR Code；手機版主要使用上面的聯絡客服按鈕。
# 請使用可信任且可長期存取的 HTTPS 圖片網址，不要依賴臨時第三方 QR 產生服務。
VITE_LINE_OA_QR_IMAGE_URL=
