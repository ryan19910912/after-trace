# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Login / Web Auth
# aftertrace-web is a dedicated Cloudflare Worker using Workers Static Assets.
WEB_APP_URL=https://aftertrace-web.<your-workers-subdomain>.workers.dev
WEB_APP_ORIGIN=https://aftertrace-web.<your-workers-subdomain>.workers.dev
WEB_AUTH_SECRET=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# Admin Web origin
# aftertrace-admin is a separate Cloudflare Worker using Workers Static Assets.
ADMIN_WEB_ORIGIN=https://aftertrace-admin.<your-workers-subdomain>.workers.dev

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_INPUT_USD_PER_MILLION_TOKENS=
GEMINI_OUTPUT_USD_PER_MILLION_TOKENS=
GEMINI_MEMORY_MAX_OUTPUT_TOKENS=
USD_TWD_RATE=
GLOBAL_FREE_AI_BUDGET_COST_TWD=
BACKGROUND_AI_MAX_SUBSIDY_COST_TWD=
ENERGY_UNITS_PER_TWD=

# Frontend build-time variable for both aftertrace-web and aftertrace-admin.
# Production builds should point this at the dedicated aftertrace-api Worker origin.
VITE_API_BASE_URL=http://localhost:8787
