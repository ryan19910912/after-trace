DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LIFF_CHANNEL_ID=
GEMINI_API_KEY=

# AFTERTRACE LIFF public entry URL used in LINE replies such as @AI 額度 and Energy-exhausted messages.
# Example: https://liff.line.me/XXXXXXXXXX-XXXXXXXX
LIFF_APP_URL=

# Billable AI runtime pricing/FX snapshots. Fill these with current provider values before enabling real Gemini calls.
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_INPUT_USD_PER_MILLION_TOKENS=
GEMINI_OUTPUT_USD_PER_MILLION_TOKENS=
USD_TWD_RATE=
# Product-defined conversion from provider TWD cost to user-visible Energy units.
ENERGY_UNITS_PER_TWD=
# Generic @AI answer output bound; used for caller Energy pre-hold safety.
GEMINI_CHAT_MAX_OUTPUT_TOKENS=512
# Memory classifier output bound. Must be deliberately chosen before Memory Gemini runtime is enabled.
# It participates in the pre-provider worst-case platform budget calculation.
GEMINI_MEMORY_MAX_OUTPUT_TOKENS=

# Hard safety ceiling for cumulative platform-funded AI cost.
GLOBAL_FREE_AI_BUDGET_COST_TWD=
# Extra per-call safety ceiling. AFTERTRACE computes the concrete worst-case Memory provider
# cost from prompt bytes + GEMINI_MEMORY_MAX_OUTPUT_TOKENS; if that risk exceeds this cap,
# Gemini is not invoked. This value is not used as a substitute for the computed risk.
BACKGROUND_AI_MAX_SUBSIDY_COST_TWD=

# Product Energy amounts/prices are intentionally left blank until product pricing is finalized.
FREE_INITIAL_ENERGY=
SUBSCRIPTION_MONTHLY_ENERGY=
SUBSCRIPTION_PRICE_TWD=
PAID_PACK_SMALL_ENERGY=
PAID_PACK_SMALL_PRICE_TWD=
PAID_PACK_MEDIUM_ENERGY=
PAID_PACK_MEDIUM_PRICE_TWD=
PAID_PACK_LARGE_ENERGY=
PAID_PACK_LARGE_PRICE_TWD=

# Provider-neutral payment adapter. AFTERTRACE sends authenticated checkout creation
# to this adapter; the adapter integrates Stripe/ECPay/etc. and sends verified payment
# events back to AFTERTRACE's internal commerce endpoint.
COMMERCE_PROVIDER=
COMMERCE_CHECKOUT_CREATE_URL=
COMMERCE_ADAPTER_SECRET=
COMMERCE_RETURN_URL=
COMMERCE_WEBHOOK_SECRET=

# Internal approved-trigger boundary for User-owned Proactive Push.
# No product trigger is invented by code; only trusted trigger producers should receive this secret.
PROACTIVE_INTERNAL_SECRET=

# Google Ad Manager Web Rewarded. AD Energy expires seven days after grant.
REWARDED_AD_ENERGY=
GOOGLE_AD_MANAGER_NETWORK_CODE=
GOOGLE_AD_MANAGER_REWARDED_AD_UNIT_PATH=

# Optional conversation/memory tuning.
CONVERSATION_EXTRACTION_MESSAGE_THRESHOLD=30
CONVERSATION_EXTRACTION_CHAR_THRESHOLD=5000
CONVERSATION_LARGE_MESSAGE_CHARS=2000
CONVERSATION_EXTRACTION_LEASE_SECONDS=120
MEMORY_REQUEST_LEASE_SECONDS=120
REWARDED_AD_DAILY_LIMIT=5
REWARDED_AD_COOLDOWN_MINUTES=15
UNPAID_RETENTION_DAYS=30
PAID_RETENTION_DAYS=365

# Exact browser origin allowed to call the LIFF management API.
# Example: https://aftertrace.pages.dev
LIFF_WEB_ORIGIN=

# User-owned Reminder reservation amount. SUBSCRIPTION Energy is eligible only when
# its lot expiry is after the scheduled delivery boundary; otherwise PAID is used.
REMINDER_RESERVATION_ENERGY=

# Single-operator Internal Admin. Protect BOTH the Admin Pages hostname and the API
# /api/v1/admin/* route with Cloudflare Access. Worker verifies the Access JWT again.
# Example team domain: your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=
ADMIN_ALLOWED_EMAIL=
# Exact Cloudflare Pages origin hosting apps/admin.
ADMIN_WEB_ORIGIN=

VITE_LIFF_ID=
VITE_API_BASE_URL=http://localhost:8787
