# AFTERTRACE 共用環境變數範例。
# 本機開發請複製成專案根目錄的 .env.local，正式／預上線環境則維護在 .env.prod。
# Drizzle 工具會直接讀取專案根目錄環境變數；pnpm dev:api 也會將本機環境變數載入 Wrangler local bindings。

# PostgreSQL / Neon 連線字串。
# .env.local 請指向本機／開發資料庫；.env.prod 請指向目前預上線／正式使用的 Neon PostgreSQL。
# 部署 migration 與 Cloudflare API Worker runtime 都使用同一個 DATABASE_URL。
DATABASE_URL=postgresql://USER:PASSWORD@HOST/aftertrace?sslmode=require

# Web/PWA 對外網址，API 產生 LINE 歷史查詢連結、登入導向等功能時會使用。
# 本機通常為 http://localhost:5173；Cloudflare 環境請填實際 aftertrace-web Worker HTTPS 網址。
WEB_APP_URL=http://localhost:5173

# Web/PWA 允許的 Origin，用於 API 的 Web/CORS/驗證邊界。
# 必須與 WEB_APP_URL 使用相同的 HTTPS origin；本機通常為 http://localhost:5173。
WEB_APP_ORIGIN=http://localhost:5173

# Web/PWA 登入與短期入口 token 簽章使用的密鑰。
# 至少 32 個字元；正式環境請使用獨立且隨機的值，不要與其他 secret 共用。
WEB_AUTH_SECRET=replace-with-at-least-32-random-characters

# Admin Web 對外網址，用於 Admin API 的 Origin/CORS 驗證。
# 本機通常為 http://localhost:5174；Cloudflare 環境請填實際 aftertrace-admin Worker HTTPS 網址。
ADMIN_WEB_ORIGIN=http://localhost:5174

# AFTERTRACE 內部管理後台登入帳號。
# 目前為單一管理員帳號驗證，不是一般使用者帳號。
ADMIN_USERNAME=admin

# AFTERTRACE 內部管理後台登入密碼。
# 至少 16 個字元；正式環境請使用獨立且隨機的密碼，並以 Cloudflare Secret 保存。
ADMIN_PASSWORD=replace-with-at-least-16-characters

# Admin 登入 session / bearer token 簽章使用的密鑰。
# 至少 32 個字元；正式環境請使用獨立且隨機的值，不要與 WEB_AUTH_SECRET 共用。
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# LINE Messaging API Channel Secret。
# 用於驗證 LINE webhook 的 X-Line-Signature，請從 LINE Developers Console 的 Messaging API channel 取得。
LINE_CHANNEL_SECRET=replace-with-line-channel-secret

# LINE Messaging API Channel Access Token。
# 用於回覆訊息、Push Message、取得 LINE attachment 內容等 Messaging API 操作。
LINE_CHANNEL_ACCESS_TOKEN=replace-with-line-channel-access-token

# LINE Login Channel ID。
# 這是公開識別碼，不屬於 secret；Web Login / OAuth 流程會使用。
LINE_LOGIN_CHANNEL_ID=2011322889

# LINE Login Channel Secret。
# 用於 LINE Login / OAuth 驗證流程，請從 LINE Developers Console 的 LINE Login channel 取得。
LINE_LOGIN_CHANNEL_SECRET=replace-with-line-login-channel-secret

# Gemini API 金鑰。
# 用於 LINE 文字紀錄標題／時間正規化、AI 編輯、圖片／音訊／文件理解等 Gemini 呼叫。
GEMINI_API_KEY=replace-with-gemini-api-key

# Web 與 Admin 在 Vite build 時使用的 API Base URL。
# 本機通常指向 http://127.0.0.1:8787；正式 build 請指向實際 after-trace-api Worker HTTPS 網址。
VITE_API_BASE_URL=http://127.0.0.1:8787

# 部署 helper 與 release:preflight 使用的實際 API Worker HTTPS 網址。
# .env.prod 請填 Cloudflare 上實際部署的 after-trace-api workers.dev 網址。
AFTERTRACE_API_URL=https://after-trace-api.<account-subdomain>.workers.dev
