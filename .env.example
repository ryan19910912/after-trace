DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LIFF_CHANNEL_ID=
GEMINI_API_KEY=

# New browser management entry. During migration the existing LIFF settings stay
# configured until Web Auth fully replaces them in production.
WEB_APP_URL=https://after-trace.pages.dev
# Dedicated HMAC secret for short-lived LINE Bot entry tickets and Web sessions.
# Use at least 32 random characters and keep this only in Worker secrets.
WEB_AUTH_SECRET=
# LINE Login OAuth channel used when a browser opens AFTERTRACE directly instead
# of entering from a signed Bot link.
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# Legacy LIFF settings. Remove only after Web Auth deployment verification.
# Public LIFF entry URL used in LINE replies.
LIFF_APP_URL=
# Exact browser origin allowed to call the LIFF management API.
LIFF_WEB_ORIGIN=

# Mutable AI model/pricing, Energy amounts, subscription/pack prices, Rewarded Ad limits,
# safety budgets and retention timing are stored in operational_settings and managed
# from Internal Admin > Settings. Do not duplicate them as Cloudflare runtime vars.

# Provider-neutral payment adapter infrastructure. Credentials remain secrets.
COMMERCE_PROVIDER=
COMMERCE_CHECKOUT_CREATE_URL=
COMMERCE_ADAPTER_SECRET=
COMMERCE_RETURN_URL=
COMMERCE_WEBHOOK_SECRET=

# Internal approved-trigger boundary for User-owned Proactive Push.
PROACTIVE_INTERNAL_SECRET=

# Google Ad Manager account/ad-unit identifiers are integration configuration;
# the mutable Reward Energy / limits live in DB-backed Admin Settings.
GOOGLE_AD_MANAGER_NETWORK_CODE=
GOOGLE_AD_MANAGER_REWARDED_AD_UNIT_PATH=

# Low-level ingestion/work lease tuning remains deployment configuration for now.
CONVERSATION_EXTRACTION_MESSAGE_THRESHOLD=30
CONVERSATION_EXTRACTION_CHAR_THRESHOLD=5000
CONVERSATION_LARGE_MESSAGE_CHARS=2000
CONVERSATION_EXTRACTION_LEASE_SECONDS=120
MEMORY_REQUEST_LEASE_SECONDS=120

# Single-operator Internal Admin. Protect the Admin Pages hostname with Cloudflare Access;
# Worker verifies the Access JWT again for /api/v1/admin/*.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=
ADMIN_ALLOWED_EMAIL=
ADMIN_WEB_ORIGIN=

# Frontend build-time variables (Cloudflare Pages, not Worker secrets).
# VITE_LIFF_ID remains only while the legacy LIFF bootstrap still exists.
VITE_LIFF_ID=
VITE_API_BASE_URL=http://localhost:8787
