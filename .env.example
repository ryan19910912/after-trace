# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Login / Web Auth
# aftertrace-web is a dedicated Cloudflare Worker using Workers Static Assets.
WEB_APP_URL=https://aftertrace-web.<your-workers-subdomain>.workers.dev
WEB_APP_ORIGIN=https://aftertrace-web.<your-workers-subdomain>.workers.dev
WEB_AUTH_SECRET=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# Admin Web / configured MVP login
# aftertrace-admin is a separate Cloudflare Worker using Workers Static Assets.
ADMIN_WEB_ORIGIN=https://aftertrace-admin.<your-workers-subdomain>.workers.dev
# Keep these three values only on aftertrace-api as Worker secrets/vars; never put them in the Admin Vite bundle.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# At least 32 characters. Rotating this invalidates all current Admin bearer sessions.
ADMIN_SESSION_SECRET=

# Worklog AI provider credential.
# Model, token pricing, media pricing and USD/TWD are runtime DB configuration managed by Worklog Admin.
GEMINI_API_KEY=

# Frontend build-time variable for both aftertrace-web and aftertrace-admin.
# Production builds should point this at the dedicated aftertrace-api Worker origin.
VITE_API_BASE_URL=http://localhost:8787
