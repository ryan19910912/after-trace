# AFTERTRACE 共用環境變數範例。
# 本機開發請複製成專案根目錄的 .env.local。
# 共用 Dev Worker 部署請維護 .env.dev；Prod Worker 部署請維護 .env.prod。
# API 部署只同步現行 Web/PWA/Extension/Auth/AI/Push/Payment/Admin runtime 所需欄位。
# 專案全面使用 Cloudflare Workers；不要使用舊的 *.pages.dev 網址。

DATABASE_URL=postgresql://USER:PASSWORD@HOST/aftertrace?sslmode=require

# Web/PWA
WEB_APP_URL=http://localhost:5173
WEB_APP_ORIGIN=http://localhost:5173
WEB_AUTH_SECRET=replace-with-at-least-32-random-characters

# Admin
ADMIN_WEB_ORIGIN=http://localhost:5174
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-at-least-8-characters
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# LINE Login：只作 provider-neutral AFTERTRACE 登入 provider。
# 注意：現行產品沒有 LINE Messaging webhook，不需要 LINE_CHANNEL_SECRET / LINE_CHANNEL_ACCESS_TOKEN。
LINE_LOGIN_CHANNEL_ID=replace-with-line-login-channel-id
LINE_LOGIN_CHANNEL_SECRET=replace-with-line-login-channel-secret

# Google Login
GOOGLE_LOGIN_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_LOGIN_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Apple Login（選填；四個欄位一起設定才啟用）
APPLE_LOGIN_CLIENT_ID=
APPLE_LOGIN_TEAM_ID=
APPLE_LOGIN_KEY_ID=
APPLE_LOGIN_PRIVATE_KEY_P8_BASE64=

# Gemini provider credential
GEMINI_API_KEY=replace-with-gemini-api-key

# NewebPay / 藍新信用卡定期定額（選填；核心欄位一起設定才啟用付款）
NEWEBPAY_MERCHANT_ID=
NEWEBPAY_HASH_KEY=
NEWEBPAY_HASH_IV=
NEWEBPAY_MODE=TEST
NEWEBPAY_PERIOD_VERSION=1.5
NEWEBPAY_PERIOD_TIMES=99
NEWEBPAY_NOTIFY_URL=
NEWEBPAY_RETURN_URL=

# Web Push VAPID
WEB_PUSH_PUBLIC_KEY=replace-with-vapid-public-key
WEB_PUSH_PRIVATE_KEY=replace-with-vapid-private-key
WEB_PUSH_SUBJECT=mailto:support@example.com

# AFTERTRACE API Base URL
VITE_API_BASE_URL=http://127.0.0.1:8787

# Chrome Web Store 上架後填入正式擴充元件頁面網址；未設定時前端只顯示尚未開放安裝。
VITE_CHROME_EXTENSION_STORE_URL=

# LINE OA 只作外部「聯絡客服」連結；不需要 webhook 或 Messaging API runtime。
VITE_LINE_OA_ADD_URL=
