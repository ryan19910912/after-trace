# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Web Push / VAPID
# Generate a key pair with: pnpm --filter @aftertrace/api webpush:keys
WEB_PUSH_VAPID_PUBLIC_KEY=replace-with-generated-public-key
WEB_PUSH_VAPID_PRIVATE_KEY=replace-with-generated-private-key
WEB_PUSH_VAPID_SUBJECT=mailto:operator@example.com

# Frontend build-time variable
VITE_API_BASE_URL=http://localhost:8787
